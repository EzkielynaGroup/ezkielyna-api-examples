{
  "$schema": "https://opencode.ai/config.json",
  "model": "ezkielyna/deepseek-v4.1-flash",
  "small_model": "ezkielyna/deepseek-v4.1-flash",
  "provider": {
    "ezkielyna": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ezkielyna",
      "options": {
        "baseURL": "https://api.ezkielyna.store/v1",
        "apiKey": "{env:EZKIELYNA_API_KEY}"
      },
      "models": {
        "deepseek-v4.1-flash": { "name": "DeepSeek V4.1 Flash", "limit": { "context": 128000, "output": 16384 } },
        "deepseek-v4-pro": { "name": "DeepSeek V4 Pro", "limit": { "context": 128000, "output": 16384 } },
        "glm-5.3": { "name": "GLM 5.3", "limit": { "context": 128000, "output": 16384 } }
      }
    }
  }
}
